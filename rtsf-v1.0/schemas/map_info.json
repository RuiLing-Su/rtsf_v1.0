{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtsf.local/schemas/v1/map_info.json",
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelope"
    }
  ],
  "properties": {
    "method": {
      "const": "map.info"
    },
    "data": {
      "type": "object",
      "required": [
        "map_id",
        "base_frame_id",
        "bounds",
        "grid",
        "map_file"
      ],
      "properties": {
        "map_id": {
          "$ref": "common.json#/$defs/id"
        },
        "base_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "type": "object",
          "required": [
            "min_x",
            "min_y",
            "max_x",
            "max_y"
          ],
          "properties": {
            "min_x": {
              "type": "number"
            },
            "min_y": {
              "type": "number"
            },
            "max_x": {
              "type": "number"
            },
            "max_y": {
              "type": "number"
            }
          }
        },
        "grid": {
          "type": "object",
          "required": [
            "resolution_m",
            "width",
            "height",
            "origin"
          ],
          "properties": {
            "resolution_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "origin": {
              "$ref": "common.json#/$defs/pose2d"
            }
          }
        },
        "map_file": {
          "type": "object",
          "required": [
            "url",
            "format",
            "sha256"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://.+"
            },
            "format": {
              "const": "ROS_MAP_ZIP"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        },
        "origin": {
          "type": "object",
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "alt": {
              "type": "number"
            }
          }
        },
        "heading_deg": {
          "type": "number"
        }
      }
    }
  },
  "not": {
    "required": [
      "request_id"
    ]
  }
}
